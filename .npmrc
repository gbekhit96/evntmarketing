# react-simple-maps@2.3.0 declares a peer range of React 16.8/17, but the project
# runs React 18. The library works fine on 18 — the metadata is just stale — and
# upgrading it would change how the homepage map renders. Without this flag,
# npm install and npm ci (used by the deploy workflow) refuse to resolve the tree.
legacy-peer-deps=true
